{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerroCrate Desktop",
  "version": "0.1.0",
  "identifier": "io.ferrocrate.desktop.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node ../../scripts/validate-bundled-sidecars.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FerroCrate Desktop",
        "width": 1200,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "nsis", "msi"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ferrocrate", "binaries/ferro-desktop"],
    "resources": {
      "../../../packaging/apparmor/usr.local.bin.ferrocrate": "packaging/apparmor/usr.local.bin.ferrocrate",
      "../../../packaging/debian/postinst": "packaging/debian/postinst",
      "../../../packaging/systemd/ferrocrate.service": "packaging/systemd/ferrocrate.service",
      "../../../packaging/macos/io.ferrocrate.desktop.plist": "packaging/macos/io.ferrocrate.desktop.plist",
      "../../../packaging/windows/install-supervisor-task.ps1": "packaging/windows/install-supervisor-task.ps1"
    },
    "icon": [
      "../public/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/etc/apparmor.d/usr.local.bin.ferrocrate": "../../../packaging/apparmor/usr.local.bin.ferrocrate",
          "/etc/systemd/system/ferrocrate.service": "../../../packaging/systemd/ferrocrate.service"
        },
        "desktopTemplate": "packaging/debian/ferrocrate-desktop.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/dgdev25/ferrocrate/releases/latest/download/latest.json"],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
