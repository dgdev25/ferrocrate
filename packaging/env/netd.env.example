FERROCRATE_AGENT_UID=REPLACE_ME
FERROCRATE_CLUSTER_ID=example-cluster
FERROCRATE_NODE_ID=host-a
FERROCRATE_NETD_SOCKET=/run/ferrocrate/netd.sock
FERROCRATE_NETD_STATE=/var/lib/ferrocrate/netd-state.json
FERROCRATE_NETD_WG_PRIVATE_KEY_PATH=/etc/ferrocrate/wireguard.key
FERROCRATE_NETD_WG_LISTEN_PORT=51820
# Base64-encoded manager Ed25519 public key. Do not use a private key here.
FERROCRATE_NETD_SIGNING_KEY=REPLACE_ME
