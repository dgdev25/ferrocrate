{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerroCrate Desktop",
  "version": "0.1.0",
  "identifier": "io.ferrocrate.desktop.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node ../../scripts/validate-bundled-sidecars.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FerroCrate Desktop",
        "width": 1200,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg",
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ferrocrate",
      "binaries/ferro-desktop-sidecar"
    ],
    "resources": {
      "../../../packaging/apparmor/usr.local.bin.ferrocrate": "packaging/apparmor/usr.local.bin.ferrocrate",
      "../../../packaging/debian/postinst": "packaging/debian/postinst",
      "../../../packaging/systemd/ferrocrate.service": "packaging/systemd/ferrocrate.service",
      "../../../packaging/macos/io.ferrocrate.desktop.plist": "packaging/macos/io.ferrocrate.desktop.plist",
      "../../../packaging/windows/install-supervisor-task.ps1": "packaging/windows/install-supervisor-task.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/debian/ferrocrate-desktop.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dgdev25/ferrocrate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxRTEwMUI2ODU2NzM4OTMKUldTVE9HZUZ0Z0hoQVRoV2xsUXM0RC9GWWw4SEdnS0FFVXNlZkRKeWp6TzNQT0lxYk5YSGRQQWgK"
    }
  }
}
