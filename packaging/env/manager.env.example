# Replace every placeholder with a production value. Keep this file out of /etc/ferrocrate.
FERROCRATE_CLUSTER_ID=example-cluster
FERROCRATE_MANAGER_ADDR=0.0.0.0:50051
FERROCRATE_CONTROL_ADDR=0.0.0.0:50053
FERROCRATE_ADMIN_ADDR=127.0.0.1:50052
FERROCRATE_MANAGER_DB=/var/lib/ferrocrate/manager.sqlite
FERROCRATE_MANAGER_TLS_CERT=/etc/ferrocrate/manager.pem
FERROCRATE_MANAGER_TLS_KEY=/etc/ferrocrate/manager-key.pem
FERROCRATE_NODE_CA_CERT=/etc/ferrocrate/node-ca.pem
FERROCRATE_ADMIN_CA_CERT=/etc/ferrocrate/admin-ca.pem
# Base64-encoded 32-byte Ed25519 seed. Do not commit a real value.
FERROCRATE_MANAGER_SIGNING_KEY=REPLACE_ME
