FERROCRATE_AGENT_RUNTIME_UID=1000
# Renew from the manager before this Unix timestamp.
FERROCRATE_AGENT_LEASE_EXPIRY_UNIX=REPLACE_ME
FERROCRATE_AGENT_IPV4_POOL=10.42.0.0/24
FERROCRATE_AGENT_IPV4_GATEWAY=10.42.0.1
FERROCRATE_AGENT_IPV4_RESERVED=10.42.0.2
FERROCRATE_AGENT_IPAM_STATE=/var/lib/ferrocrate/agent-ipam.json
FERROCRATE_AGENT_SOCKET=/run/ferrocrate/agent.sock
FERROCRATE_AGENT_STATE=/var/lib/ferrocrate/agent-state.json
FERROCRATE_AGENT_OVERLAYS_JSON={"prod":{"bridge":"fcprod","gateway":"10.42.0.1","prefix":24,"mtu":1420}}
FERROCRATE_NODE_ID=host-a
FERROCRATE_CLUSTER_ID=example-cluster
FERROCRATE_NETD_SOCKET=/run/ferrocrate/netd.sock
# Base64-encoded manager Ed25519 public key.
FERROCRATE_NETD_SIGNING_KEY=REPLACE_ME
FERROCRATE_CONTROL_ENDPOINT=https://manager.example:50053
FERROCRATE_CONTROL_TLS_DOMAIN=manager.example
FERROCRATE_NODE_CA_CERT=/etc/ferrocrate/node-ca.pem
FERROCRATE_AGENT_TLS_CERT=/etc/ferrocrate/agent.pem
FERROCRATE_AGENT_TLS_KEY=/etc/ferrocrate/agent-key.pem
