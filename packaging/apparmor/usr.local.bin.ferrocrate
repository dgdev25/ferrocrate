#include <tunables/global>

# Ubuntu restricts unprivileged user namespaces to explicitly profiled tasks.
# Keep FerroCrate's existing host permissions while granting that one LSM rule.
profile usr.local.bin.ferrocrate /usr/local/bin/ferrocrate flags=(unconfined) {
  userns,

  # Existing Linux capability access remains unchanged by the unconfined attachment.
  #include if exists <local/usr.local.bin.ferrocrate>
}
